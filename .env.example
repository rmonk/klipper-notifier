# =============================================================================
# notify-klipper Environment Configuration Example
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Moonraker (Klipper / Fluidd / Mainsail) Configuration
# -----------------------------------------------------------------------------
# Base URL for Moonraker API and WebSocket (default: http://127.0.0.1:7125)
MOONRAKER_URL=http://127.0.0.1:7125

# Optional Moonraker API Key.
# If your Moonraker instance allows trusted clients on local LAN without auth,
# leave this empty.
MOONRAKER_API_KEY=

# Or read API key from a mounted secret file:
# MOONRAKER_API_KEY_FILE=/run/secrets/moonraker_key

# -----------------------------------------------------------------------------
# Notify! (iOS Live Activity & Push Notifications) Configuration
# Get your Device ID & Token in the Notify! app under Settings -> API Keys
# -----------------------------------------------------------------------------
NOTIFY_DEVICE_ID=
NOTIFY_DEVICE_TOKEN=

# Or read Notify tokens from mounted secret files:
# NOTIFY_DEVICE_ID_FILE=/run/secrets/notify_device_id
# NOTIFY_DEVICE_TOKEN_FILE=/run/secrets/notify_device_token

# -----------------------------------------------------------------------------
# Display & Notification Settings
# -----------------------------------------------------------------------------
# Name shown in Live Activity title
PRINTER_NAME=Klipper 3D Printer

# Show metric chips (Nozzle temp, Bed temp, Layer count) on Live Activity (default: false)
SHOW_METRICS=false

# Show trailing layer count (e.g. "Layer 12/150") on Live Activity (default: false)
SHOW_TRAILING_LAYER=false

# Send push notifications on print start/completion/pause (default: false, only Live Activity is sent)
ENABLE_PUSH_NOTIFICATIONS=false

# Polling interval for REST keepalive / fallback (e.g., 2s, 5s)
POLL_INTERVAL=2s

# How long (in seconds) to keep the completed print Live Activity tile on screen (default: 300)
KEEP_FOR_SECONDS=300

# Set to true to simulate Notify! API calls without sending real notifications
DRY_RUN=false

# Verbose debug logging
VERBOSE=false
